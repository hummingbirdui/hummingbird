{
  "name": "@hummingbirdui/docs",
  "private": true,
  "version": "1.4.0",
  "description": "Documentation site for Hummingbird UI",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:astro\" \"npm run watch:themes\"",
    "dev:astro": "astro dev --host",
    "build": "npm run build:themes && astro build",
    "preview": "astro preview",
    "start:docs-js": "esbuild src/docs.ts --bundle --outfile=static/docs.js --watch",
    "build:themes": "npx @tailwindcss/cli -i src/themes/themes.css -o public/themes.css",
    "watch:themes": "npx @tailwindcss/cli -i src/themes/themes.css -o public/themes.css --watch",
    "deploy": "node deployment.js production",
    "deploy:staging": "node deployment.js staging",
    "deploy:internal": "echo staging.hbui.dev > ./dist/CNAME && gh-pages -d dist -r https://github.com/hummingbirdui/staging.git"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@hummingbirdui/browser": "workspace:*",
    "@hummingbirdui/hummingbird": "workspace:*",
    "@tailwindcss/cli": "^4.3.3",
    "dedent": "^1.7.2",
    "sharp": "^0.35.3",
    "shiki": "^4.4.2",
    "swiper": "^14.0.7"
  },
  "devDependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@docsearch/css": "^3.9.0",
    "@docsearch/js": "^3.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.1",
    "astro-auto-import": "^0.5.2",
    "choices.js": "^11.2.3",
    "concurrently": "^10.0.4",
    "dropzone": "6.0.0-beta.2",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.1",
    "flatpickr": "^4.6.13",
    "fs-extra": "^11.4.0",
    "gh-pages": "^6.3.0",
    "gsap": "^3.15.0",
    "is_js": "^0.9.0",
    "nouislider": "^15.8.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
